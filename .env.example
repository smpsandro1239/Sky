POSTGRES_DB=sky
POSTGRES_USER=sky
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://sky:change-me-local-only@db:5432/sky
REDIS_URL=redis://redis:6379/0
API_PORT=8000
WEB_PORT=3000

# API security and browser integration
SKY_ENV=development
SKY_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=20
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional SMTP delivery for trip invitations (leave SMTP_HOST empty to use copyable links)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Amadeus flight search (optional; use test.api.amadeus.com for sandbox)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Google OAuth credentials (configure before enabling Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
